# Keep the release archive (and therefore the Zenodo artifact) free of files
# that are only useful inside the repository. Documentation source is kept
# deliberately: the archived record should be self-contained.
.github/            export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore

# Normalize line endings so archives are reproducible across platforms.
* text=auto eol=lf
*.f90   text
*.py    text
*.md    text
*.png   binary
*.jpg   binary
